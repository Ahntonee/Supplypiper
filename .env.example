# Copy to .env.<mode> and never commit it. No secrets belong in this file.
# demo | testnet | production — each mode uses its OWN database and config.
SUPPLYPIPER_MODE=demo
PORT=4000
DATABASE_URL=postgresql://supplypiper:change-me@localhost:5432/supplypiper_demo
# mock is rejected outside demo mode (see apps/api/src/config.ts)
VERIFICATION_ADAPTER=mock
# disabled | mock (demo only) | real
PAYMENT_ADAPTER=disabled
VERIFICATION_FRESHNESS_SECONDS=300
SEEDED_CREDENTIALS=false
REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com/mcp
# Audience string bound into wallet-ownership challenges (the public host name of this deployment)
PUBLIC_ORIGIN=localhost
# Development-only mail inbox at /api/v1/dev/inbox (loopback only; refused in production)
DEV_INBOX=false
# --- AI assistant (optional; the product works fully without it) ---
# none | anthropic. The key is server-side only. Without it the assistant shows "unavailable" and the manual form keeps working.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# Per-run limits. Cost limit is in micro-USD (100000 = $0.10). Prices default to published rates; verify them.
AI_RUN_COST_LIMIT_MICROUSD=100000
AI_MAX_TOOL_CALLS=6
AI_MAX_TURNS=5
# Off by default because it could not be tested without credentials.
AI_REFUSAL_FALLBACK=false
