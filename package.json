{
  "name": "supplypiper",
  "version": "0.0.0",
  "private": true,
  "description": "SupplyPiper — Source clearly. Approve confidently.",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:registry": "node scripts/spike-registry.mjs",
    "dev:api": "tsx apps/api/src/server.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.3.0",
    "zod": "4.6.7"
  }
}
