{
  "name": "supplypiper",
  "version": "0.0.0",
  "private": true,
  "description": "SupplyPiper — Source clearly. Approve confidently.",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:registry": "node scripts/spike-registry.mjs",
    "dev:api": "tsx --env-file=.env apps/api/src/server.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "test:integration": "vitest run tests/integration",
    "dev:web": "vite --config apps/web/vite.config.ts apps/web",
    "build:web": "vite build --config apps/web/vite.config.ts apps/web",
    "contrast": "node scripts/contrast.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "e2e": "node tests/e2e/buyer-decision.mjs",
    "e2e:supplier": "node tests/e2e/supplier-workspace.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "embedded-postgres": "18.6.0-beta.19",
    "playwright": "1.65.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.5",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.107.1",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  }
}
